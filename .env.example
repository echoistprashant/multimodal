# Application
PROJECT_NAME="Multimodal Document Intelligence System"
ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/mdis_db"
REDIS_URL="redis://localhost:6379/0"

# Storage
STORAGE_BACKEND="local"
LOCAL_STORAGE_DIR="./storage"

# MinIO / S3 (optional if using local backend)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="mdis-docs"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_REGION="us-east-1"

# Document & Pipeline
MAX_FILE_SIZE_BYTES=26214400
MAX_PAGES_PER_DOCUMENT=100
RENDER_DPI=200
OCR_ENGINE="tesseract"
CONFIDENCE_AUTO_APPROVE_THRESHOLD=0.85

# Multimodal / AI Models
EMBEDDING_MODEL="BAAI/bge-m3"
EMBEDDING_DIM=1024
VLM_PROVIDER="gemini"
VLM_MODEL="gemini-1.5-flash"
LLM_API_KEY=""
